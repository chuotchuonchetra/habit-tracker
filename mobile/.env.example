# Copy to mobile/.env and fill in. Never commit it.
# Expo inlines EXPO_PUBLIC_* into the bundle, so treat these as public — they are
# the same anon/publishable key the web app uses, which is designed to be public.
# Only VITE_/EXPO_PUBLIC_ vars reach client code; anything else stays server-side.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
